---
const { title } = Astro.props;
---
<article class="mx-auto max-w-content px-5 py-12">
  <h1 class="mb-6 text-3xl font-bold tracking-tight">{title}</h1>
  <div class="space-y-4 leading-relaxed text-ink [&_a]:text-accent [&_code]:rounded [&_code]:bg-card [&_code]:px-1 [&_code]:py-0.5 [&_code]:text-[0.9em] [&_h2]:mt-8 [&_h2]:text-lg [&_h2]:font-semibold [&_h3]:mt-6 [&_h3]:font-semibold [&_li]:mt-1 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6"><slot /></div>
</article>
