---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

// 全部是产品真机截图：由 scripts/capture.mjs 用扩展自己的渲染代码 @2x 拍出来的，
// 不是重绘的示意图。演示文章也是自己写的，不是别人网站的快照。
//
// Mac 两张是整幅铺开而不是并排两列：面板宽 250 CSS px，在 1280 宽的截图里只占
// 五分之一，塞进两列后面板不到 110px、字号不足 5px，等于放了一张看不清的图。
//
// 每张都自带机身外壳，四角是透明的 —— 再套 rounded-2xl + border 会在透明角外面
// 画出一圈方框，所以一律不加边框类，圆角和阴影都在 PNG 里。
const mac = [
  { file: 'panel-light', w: 3306, h: 1897, alt: 'shots.alt.panel', caption: 'shots.panel' },
  { file: 'panel-dark', w: 3306, h: 1897, alt: 'shots.alt.panelDark', caption: 'shots.panelDark' },
] as const;
const pad = { file: 'ipad-panel-light', w: 2930, h: 2245, alt: 'shots.alt.ipad', caption: 'shots.ipad' } as const;
const phone = [
  { file: 'ball-light', alt: 'shots.alt.ball', caption: 'shots.ball' },
  { file: 'sheet-light', alt: 'shots.alt.sheet', caption: 'shots.sheet' },
  { file: 'sheet-dark', alt: 'shots.alt.sheetDark', caption: null },
] as const;
---
<section id="screens" class="mx-auto max-w-6xl scroll-mt-16 px-5 py-16">
  <h2 class="mb-10 text-center text-2xl font-semibold">{t('shots.heading')}</h2>

  <div class="space-y-8">
    {mac.map((s, i) => (
      <figure>
        <img
          src={`${base}screenshots/${s.file}.png`}
          alt={t(s.alt)}
          width={s.w}
          height={s.h}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full"
        />
        <figcaption class="mt-3 text-sm text-muted">{t(s.caption)}</figcaption>
      </figure>
    ))}

    <figure>
      <img
        src={`${base}screenshots/${pad.file}.png`}
        alt={t(pad.alt)}
        width={pad.w}
        height={pad.h}
        loading="lazy"
        decoding="async"
        class="w-full"
      />
      <figcaption class="mt-3 text-sm text-muted">{t(pad.caption)}</figcaption>
    </figure>
  </div>

  <div class="mt-8 grid gap-6 sm:grid-cols-3">
    {phone.map((s) => (
      <figure>
        <img
          src={`${base}screenshots/${s.file}.png`}
          alt={t(s.alt)}
          width="1359"
          height="2736"
          loading="lazy"
          decoding="async"
          class="w-full"
        />
        {s.caption && <figcaption class="mt-3 text-sm text-muted">{t(s.caption)}</figcaption>}
      </figure>
    ))}
  </div>
</section>
