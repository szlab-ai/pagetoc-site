---
import { useTranslations } from '../i18n/utils';
import { appStoreURL } from '../lib/schema';
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const storeURL = appStoreURL(lang);
const badge = lang === 'zh'
  ? 'brand/download-on-the-app-store-zh-cn.svg'
  : 'brand/download-on-the-app-store-en.svg';
---
<section class="mx-auto max-w-3xl px-5 pt-20 pb-12 text-center">
  {/* 首屏 LCP 元素：显式 eager + 高优先级，别让它排在下面的懒加载截图后面。 */}
  <img
    src={`${base}brand/pagetoc.png`}
    alt=""
    width="112"
    height="112"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="mx-auto mb-6 h-28 w-28"
  />
  {/* 标语并进 h1：只有品牌名的 h1 里没有任何人会去搜的词。 */}
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    PageTOC
    <span class="mt-4 block text-xl font-normal leading-snug tracking-normal text-ink/90 sm:text-2xl">{t('hero.tagline')}</span>
  </h1>
  <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">{t('hero.subtitle')}</p>

  <a
    href={storeURL}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 inline-block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  >
    <img src={`${base}${badge}`} alt={t('hero.appStoreAlt')} height="52" class="h-[52px] w-auto" />
  </a>
  <p class="mt-3 text-sm text-muted">{t('hero.platforms')}</p>
</section>
