---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<section class="mx-auto max-w-3xl px-5 pt-20 pb-12 text-center">
  {/* 首屏 LCP 元素：显式 eager + 高优先级，别让它排在下面的懒加载截图后面。 */}
  <img
    src={`${base}brand/pagetoc.png`}
    alt=""
    width="112"
    height="112"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="mx-auto mb-6 h-28 w-28"
  />
  {/* 标语并进 h1：只有品牌名的 h1 里没有任何人会去搜的词。 */}
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    PageTOC
    <span class="mt-4 block text-xl font-normal leading-snug tracking-normal text-ink/90 sm:text-2xl">{t('hero.tagline')}</span>
  </h1>
  <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">{t('hero.subtitle')}</p>

  {/* 刻意不是链接：App 还没上架，一个指向 404 的 App Store 按钮比没有按钮更糟。
      上架当天把这里换成真正的 Download on the App Store 徽章。 */}
  <p class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-card px-4 py-2 text-sm font-medium">
    <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
    {t('hero.status')}
  </p>
  <p class="mt-3 text-sm text-muted">{t('hero.platforms')}</p>
</section>
